{
 "tpl": "\n\n<div style=\"min-height:100%;background:#0F1320;color:#EAEFFA;font-family:'Barlow',system-ui,sans-serif;font-size:16px;line-height:1.5;display:flex;flex-wrap:wrap\">\n\n<aside style=\"flex:1 1 230px;max-width:100%;background:#171C2B;border-right:1px solid #2B3248;padding:20px 16px;display:flex;flex-direction:column;gap:20px;box-sizing:border-box\">\n<a href=\"Store.dc.html\" style=\"display:flex;align-items:center;gap:10px;color:#EAEFFA;padding:0 8px\">\n<img src=\"/sonna-mark.svg\" width=\"34\" height=\"34\" alt=\"SONNA\" style=\"display:block\">\n<span style=\"font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:24px;letter-spacing:0.05em\">SONNA <span style=\"color:#A3ACC4;font-size:14px;letter-spacing:0.1em\">ADMIN</span></span>\n</a>\n<nav aria-label=\"Menu quản trị\" style=\"display:flex;flex-direction:column;gap:4px\">\n<template data-tag=\"sc-for\" list=\"{{nav}}\" as=\"n\" hint-placeholder-count=\"10\">\n<a href=\"{{n.href}}\" style=\"display:flex;align-items:center;min-height:44px;padding:0 12px;border-radius:8px;font-weight:500;background:{{n.bg}};color:{{n.fg}}\">{{n.label}}</a>\n</template>\n</nav>\n<div style=\"margin-top:auto;padding:12px;background:#1F2538;border-radius:10px;font-size:14px;display:flex;flex-direction:column\">\n<span style=\"font-weight:600\">[Tên admin]</span>\n<span style=\"color:#A3ACC4\">Quản trị viên</span>\n</div>\n</aside>\n\n<main style=\"flex:999 1 560px;min-width:0;padding:28px 32px;display:flex;flex-direction:column;gap:24px;box-sizing:border-box\">\n<div style=\"display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px\">\n<div style=\"display:flex;flex-direction:column\">\n<h1 style=\"margin:0;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:40px;line-height:1.1\">Tổng quan</h1>\n<span style=\"color:#A3ACC4;font-size:14px\">{{today}} · Dữ liệu mẫu để minh họa bố cục</span>\n</div>\n<a href=\"AdminAccounts.dc.html\" style=\"display:inline-flex;align-items:center;min-height:44px;padding:0 20px;border-radius:8px;background:#FF8A1F;color:#1A1206;font-weight:600\">+ Đăng acc mới</a>\n</div>\n\n<section aria-label=\"Doanh thu\" style=\"display:flex;flex-wrap:wrap;gap:16px\">\n<template data-tag=\"sc-for\" list=\"{{revenue}}\" as=\"r\" hint-placeholder-count=\"3\">\n<div style=\"flex:1 1 260px;padding:24px;background:#171C2B;border:1px solid #2B3248;border-top:4px solid #FF8A1F;border-radius:12px;display:flex;flex-direction:column;gap:4px\">\n<span style=\"font-size:14px;color:#A3ACC4\">{{r.label}}</span>\n<span style=\"font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:48px;line-height:1.1;color:#FF8A1F\">{{r.value}}</span>\n<span style=\"font-size:13px;color:#A3ACC4\">{{r.sub}}</span>\n</div>\n</template>\n</section>\n\n<section style=\"display:flex;flex-wrap:wrap;gap:16px\">\n<template data-tag=\"sc-for\" list=\"{{kpis}}\" as=\"k\" hint-placeholder-count=\"3\">\n<div style=\"flex:1 1 200px;padding:20px;background:#171C2B;border:1px solid #2B3248;border-radius:12px;display:flex;flex-direction:column;gap:4px\">\n<span style=\"font-size:14px;color:#A3ACC4\">{{k.label}}</span>\n<span style=\"font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:36px;line-height:1.1;color:{{k.col}}\">{{k.value}}</span>\n<span style=\"font-size:13px;color:#A3ACC4\">{{k.sub}}</span>\n</div>\n</template>\n</section>\n\n<section style=\"display:flex;flex-wrap:wrap;gap:16px;align-items:stretch\">\n<div style=\"flex:2 1 460px;min-width:0;padding:20px;background:#171C2B;border:1px solid #2B3248;border-radius:12px;display:flex;flex-direction:column;gap:16px\">\n<div style=\"display:flex;justify-content:space-between;align-items:center\">\n<h2 style=\"margin:0;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:24px\">Doanh thu 7 ngày gần nhất</h2>\n<label style=\"font-size:14px;color:#A3ACC4;display:flex;align-items:center;gap:8px\">Khoảng\n<select style=\"min-height:40px;padding:0 10px;background:#1F2538;border:1px solid #2B3248;border-radius:8px;color:#EAEFFA;font-size:14px\"><option>7 ngày</option><option>30 ngày</option><option>12 tháng</option></select></label>\n</div>\n<div style=\"display:flex;align-items:flex-end;gap:12px;height:230px;padding-top:8px;border-bottom:1px solid #2B3248\">\n<template data-tag=\"sc-for\" list=\"{{bars}}\" as=\"b\" hint-placeholder-count=\"7\">\n<div style=\"flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:6px;height:100%\">\n<span style=\"font-size:13px;color:#A3ACC4\">{{b.v}}</span>\n<div style=\"width:100%;max-width:56px;border-radius:6px 6px 0 0;background:#FF8A1F;height:{{b.h}}\"></div>\n</div>\n</template>\n</div>\n<div style=\"display:flex;gap:12px\">\n<template data-tag=\"sc-for\" list=\"{{bars}}\" as=\"b\" hint-placeholder-count=\"7\">\n<span style=\"flex:1;text-align:center;font-size:13px;color:#A3ACC4\">{{b.d}}</span>\n</template>\n</div>\n</div>\n\n<div style=\"flex:1 1 300px;min-width:0;padding:20px;background:#171C2B;border:1px solid #2B3248;border-radius:12px;display:flex;flex-direction:column;gap:12px;max-height:420px;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable\">\n<h2 style=\"margin:0;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:24px\">Cần xử lý</h2>\n<template data-tag=\"sc-for\" list=\"{{todo}}\" as=\"t\" hint-placeholder-count=\"4\">\n<div style=\"display:flex;align-items:center;gap:12px;padding:12px;background:#1F2538;border-radius:10px\">\n<span style=\"min-width:36px;text-align:center;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:26px;color:{{t.col}}\">{{t.n}}</span>\n<span style=\"flex:1;font-size:15px\">{{t.text}}</span>\n<a href=\"{{t.href}}\" style=\"font-weight:600;font-size:14px\">Xử lý</a>\n</div>\n</template>\n</div>\n</section>\n\n<section style=\"padding:20px;background:#171C2B;border:1px solid #2B3248;border-radius:12px;display:flex;flex-direction:column;gap:12px\">\n<div style=\"display:flex;justify-content:space-between;align-items:center\">\n<h2 style=\"margin:0;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:24px\">Đơn hàng gần đây</h2>\n<a href=\"AdminOrders.dc.html\" style=\"font-weight:600;font-size:14px\">Xem tất cả</a>\n</div>\n<div style=\"overflow-x:auto;max-height:520px;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable\">\n<table style=\"width:100%;min-width:640px;border-collapse:collapse;font-size:15px\">\n<thead>\n<tr style=\"text-align:left;color:#A3ACC4;font-size:13px\">\n<th style=\"padding:10px 12px;border-bottom:1px solid #2B3248;font-weight:500;position:sticky;top:0;z-index:1;background:#171C2B\">Mã đơn</th>\n<th style=\"padding:10px 12px;border-bottom:1px solid #2B3248;font-weight:500;position:sticky;top:0;z-index:1;background:#171C2B\">Khách hàng</th>\n<th style=\"padding:10px 12px;border-bottom:1px solid #2B3248;font-weight:500;position:sticky;top:0;z-index:1;background:#171C2B\">Acc</th>\n<th style=\"padding:10px 12px;border-bottom:1px solid #2B3248;font-weight:500;position:sticky;top:0;z-index:1;background:#171C2B\">Số tiền</th>\n<th style=\"padding:10px 12px;border-bottom:1px solid #2B3248;font-weight:500;position:sticky;top:0;z-index:1;background:#171C2B\">Trạng thái</th>\n<th style=\"padding:10px 12px;border-bottom:1px solid #2B3248;font-weight:500;position:sticky;top:0;z-index:1;background:#171C2B\">Thời gian</th>\n</tr>\n</thead>\n<tbody>\n<template data-tag=\"sc-for\" list=\"{{orders}}\" as=\"o\" hint-placeholder-count=\"6\">\n<tr>\n<td style=\"padding:12px;border-bottom:1px solid #2B3248;font-weight:600\">{{o.id}}</td>\n<td style=\"padding:12px;border-bottom:1px solid #2B3248\">{{o.user}}</td>\n<td style=\"padding:12px;border-bottom:1px solid #2B3248\">{{o.acc}}</td>\n<td style=\"padding:12px;border-bottom:1px solid #2B3248\">{{o.amount}}</td>\n<td style=\"padding:12px;border-bottom:1px solid #2B3248\"><span style=\"display:inline-block;padding:2px 12px;border-radius:999px;background:#1F2538;font-size:13px;font-weight:600;color:{{o.col}}\">{{o.status}}</span></td>\n<td style=\"padding:12px;border-bottom:1px solid #2B3248;color:#A3ACC4\">{{o.time}}</td>\n</tr>\n</template>\n</tbody>\n</table>\n</div>\n</section>\n</main>\n\n</div>\n",
 "helmet": "\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&amp;family=Barlow:wght@400;500;600&amp;display=swap\">\n<style>\nbody{margin:0;background:#0F1320}\na{color:#52C7FF;text-decoration:none}a:hover{color:#8EDDFF}\na:focus-visible,button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid #52C7FF;outline-offset:2px}\n</style>\n",
 "script": "class Component extends DCLogic {\nstate = { data: null, error: '' };\nmount() { this.refresh(); }\nrefresh() {\nconst api = parent.SONNA_API;\nif (!api) return this.setState({ error: 'Không kết nối được máy chủ.' });\napi('GET', '/api/admin/dashboard').then((r) => {\nif (r._status !== 200) return this.setState({ error: r.error || 'Không tải được dữ liệu.' });\nthis.setState({ data: r, error: '' });\n}).catch(() => this.setState({ error: 'Lỗi kết nối máy chủ.' }));\n}\nrenderVals() {\nconst d = this.state.data || {}, fmt = (n) => String(Number(n) || 0).replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.') + '₫';\nconst on = '#FF8A1F', off = '#A3ACC4';\nconst nav = [\n{ label: 'Tổng quan', href: 'AdminDashboard.dc.html', active: true }, { label: 'Quản lý acc', href: 'AdminAccounts.dc.html' },\n{ label: 'Đơn hàng', href: 'AdminOrders.dc.html' }, { label: 'Thanh toán', href: 'AdminPayments.dc.html' },\n{ label: 'Người dùng', href: 'AdminUsers.dc.html' }, { label: 'Khuyến mãi', href: 'AdminPromos.dc.html' },\n{ label: 'Nội dung website', href: 'AdminContent.dc.html' }, { label: 'Báo cáo', href: '#bao-cao' },\n{ label: 'Phân quyền', href: 'AdminRoles.dc.html' }, { label: 'Nhật ký hoạt động', href: '#nhat-ky' }\n].map((n) => ({ ...n, bg: n.active ? '#1F2538' : 'transparent', fg: n.active ? on : off }));\nconst revenue = [\n{ label: 'Doanh thu hôm nay', value: fmt(d.today && d.today.revenue), sub: (d.today && d.today.count || 0) + ' đơn' },\n{ label: 'Doanh thu tháng này', value: fmt(d.month && d.month.revenue), sub: (d.month && d.month.count || 0) + ' đơn' },\n{ label: 'Tài khoản khách hàng', value: String(d.users || 0), sub: 'Tài khoản đã đăng ký' }\n];\nconst kpis = [\n{ label: 'Đơn hàng', value: String(d.orders || 0), sub: 'Tổng đơn đã tạo', col: '#52C7FF' },\n{ label: 'Acc có TK|MK thật', value: String(d.stock || 0), sub: 'Sẵn sàng bán', col: '#43D9A0' },\n{ label: 'Giao dịch cần đối soát', value: String(d.unmatchedDeposits || 0), sub: 'Nội dung chuyển khoản chưa khớp', col: '#FFC24B' }\n];\nconst days = d.days || [], bars = days.map((x) => ({ d: x.label, v: fmt(x.value), h: x.height + 'px' }));\nconst todo = [{ n: String(d.unmatchedDeposits || 0), text: 'Giao dịch chưa khớp nội dung chuyển khoản', href: 'AdminOrders.dc.html', col: '#FF8A1F' }];\nconst orders = (d.recentOrders || []).map((o) => ({ id: o.code, user: o.username, acc: o.title, amount: fmt(o.total), status: o.status, col: o.status === 'Hoàn tất' ? '#43D9A0' : (o.status === 'Đã hoàn tiền' ? off : '#FFC24B'), time: o.time }));\nreturn { nav, today: this.state.error || ('Dữ liệu thực · ' + new Date().toLocaleDateString('vi-VN')), revenue, kpis, bars, todo, orders };\n}\n}",
 "props": {},
 "title": "Admin - Tổng quan"
}
