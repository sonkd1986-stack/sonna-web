 "script": "class Component extends DCLogic {\nstate = { data: null, error: '' };\nmount() { this.refresh(); }\nrefresh() {\nconst api = parent.SONNA_API;\nif (!api) return this.setState({ error: 'KhÃ´ng káº¿t ná»‘i Ä‘Æ°á»£c mÃ¡y chá»§.' });\napi('GET', '/api/admin/dashboard').then((r) => {\nif (r._status !== 200) return this.setState({ error: r.error || 'KhÃ´ng táº£i Ä‘Æ°á»£c dá»¯ liá»‡u.' });\nthis.setState({ data: r, error: '' });\n}).catch(() => this.setState({ error: 'Lá»—i káº¿t ná»‘i mÃ¡y chá»§.' }));\n}\nrenderVals() {\nconst d = this.state.data || {}, fmt = (n) => String(Number(n) || 0).replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.') + 'â‚«';\nconst on = '#FF8A1F', off = '#A3ACC4';\nconst nav = [\n{ label: 'Tá»•ng quan', href: 'AdminDashboard.dc.html', active: true }, { label: 'Quáº£n lÃ½ acc', href: 'AdminAccounts.dc.html' },\n{ label: 'ÄÆ¡n hÃ ng', href: 'AdminOrders.dc.html' }, { label: 'Thanh toÃ¡n', href: 'AdminPayments.dc.html' },\n{ label: 'NgÆ°á»i dÃ¹ng', href: 'AdminUsers.dc.html' }, { label: 'Khuyáº¿n mÃ£i', href: 'AdminPromos.dc.html' },\n{ label: 'Ná»™i dung website', href: 'AdminContent.dc.html' }, { label: 'BÃ¡o cÃ¡o', href: '#bao-cao' },\n{ label: 'PhÃ¢n quyá»n', href: 'AdminRoles.dc.html' }, { label: 'Nháº­t kÃ½ hoáº¡t Ä‘á»™ng', href: '#nhat-ky' }\n].map((n) => ({ ...n, bg: n.active ? '#1F2538' : 'transparent', fg: n.active ? on : off }));\nconst revenue = [\n{ label: 'Doanh thu hÃ´m nay', value: fmt(d.today && d.today.revenue), sub: (d.today && d.today.count || 0) + ' Ä‘Æ¡n' },\n{ label: 'Doanh thu thÃ¡ng nÃ y', value: fmt(d.month && d.month.revenue), sub: (d.month && d.month.count || 0) + ' Ä‘Æ¡n' },\n{ label: 'TÃ i khoáº£n khÃ¡ch hÃ ng', value: String(d.users || 0), sub: 'TÃ i khoáº£n Ä‘Ã£ Ä‘Äƒng kÃ½' }\n];\nconst kpis = [\n{ label: 'ÄÆ¡n hÃ ng', value: String(d.orders || 0), sub: 'Tá»•ng Ä‘Æ¡n Ä‘Ã£ táº¡o', col: '#52C7FF' },\n{ label: 'Acc cÃ³ TK|MK tháº­t', value: String(d.stock || 0), sub: 'Sáºµn sÃ ng bÃ¡n', col: '#43D9A0' },\n{ label: 'Giao dá»‹ch cáº§n Ä‘á»‘i soÃ¡t', value: String(d.unmatchedDeposits || 0), sub: 'Ná»™i dung chuyá»ƒn khoáº£n chÆ°a khá»›p', col: '#FFC24B' }\n];\nconst days = d.days || [], bars = days.map((x) => ({ d: x.label, v: fmt(x.value), h: x.height + 'px' }));\nconst todo = [{ n: String(d.unmatchedDeposits || 0), text: 'Giao dá»‹ch chÆ°a khá»›p ná»™i dung chuyá»ƒn khoáº£n', href: 'AdminOrders.dc.html', col: '#FF8A1F' }];\nconst orders = (d.recentOrders || []).map((o) => ({ id: o.code, user: o.username, acc: o.title, amount: fmt(o.total), status: o.status, col: o.status === 'HoÃ n táº¥t' ? '#43D9A0' : (o.status === 'ÄÃ£ hoÃ n tiá»n' ? off : '#FFC24B'), time: o.time }));\nreturn { nav, today: this.state.error || ('Dá»¯ liá»‡u thá»±c Â· ' + new Date().toLocaleDateString('vi-VN')), revenue, kpis, bars, todo, orders };\n}\n}",
