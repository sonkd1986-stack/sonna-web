elected) || list[0];\nconst counts = { all: list.length, paid: list.filter((o) => o.status === 'ÄÃ£ thanh toÃ¡n').length, delivery: list.filter((o) => o.status === 'Äang bÃ n giao').length, done: list.filter((o) => o.status === 'HoÃ n táº¥t').length, refund: list.filter((o) => o.status === 'ÄÃ£ hoÃ n tiá»n').length };\nconst tabs = [{ label: 'Táº¥t cáº£', count: String(counts.all) }, { label: 'ÄÃ£ thanh toÃ¡n', count: String(counts.paid) }, { label: 'Äang bÃ n giao', count: String(counts.delivery) }, { label: 'HoÃ n táº¥t', count: String(counts.done) }, { label: 'HoÃ n tiá»n', count: String(counts.refund) }].map((t, i) => ({ ...t, line: i === 0 ? on : 'transparent', fg: i === 0 ? '#EAEFFA' : off }));\nconst orders = list.map((o) => ({ id: o.code, user: o.username, acc: o.title, amount: fmt(o.total), status: o.status, col: o.status === 'HoÃ n táº¥t' ? '#43D9A0' : (o.status === 'ÄÃ£ hoÃ n tiá»n' ? off : '#FFC24B'), time: o.time, bg: o.code === (current && current.code) ? '#1F2538' : 'transparent' }));\nconst query = (st.q || '').trim().toLowerCase();\nconst customerMap = new Map();\nlist.forEach((o) => { if (!customerMap.has(o.userId)) customerMap.set(o.userId, { name: o.username, contact: o.username, orders: [] }); customerMap.get(o.userId).orders.push(o); });\nconst found = Array.from(customerMap.values()).filter((u) => !query || u.name.toLowerCase().includes(query)).slice(0, 5);\nconst cs = { none: !!query && !found.length, list: found.length > 0, items: found.map((u) => ({ name: u.name, contact: u.contact, summary: u.orders.length + ' ÄÆ¡n hÃ ng', orders: u.orders.map((o) => ({ time: o.time, order: o.code, cat: o.title, sub: o.itemId, tk: ((o.accs || [])[0] || {}).line || '', mkShown: '????????', price: fmt(o.total), priceCol: on, status: o.status, statusCol: '#FFC24B', revealLabel: 'Hiá»‡n', toggle: () => this.setState({ selected: o.code }) })) })) };\nconst status = current ? current.status : 'ChÆ°a cÃ³ Ä‘Æ¡n';\nconst col = status === 'HoÃ n táº¥t' ? '