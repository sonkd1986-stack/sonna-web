ollbar-gutter:stable\">\n<span style=\"font-weight:600;margin-bottom:8px\">Tiáº¿n trÃ¬nh Ä‘Æ¡n</span>\n<template data-tag=\"sc-for\" list=\"{{steps}}\" as=\"s\" hint-placeholder-count=\"5\">\n<div style=\"display:flex;gap:12px;align-items:flex-start;padding-bottom:12px\">\n<span aria-hidden=\"true\" style=\"margin-top:6px;width:12px;height:12px;border-radius:999px;flex:none;background:{{s.dot}}\"></span>\n<div style=\"display:flex;flex-direction:column;line-height:1.3\">\n<span style=\"font-size:15px;color:{{s.fg}}\">{{s.label}}</span>\n<span style=\"font-size:13px;color:#A3ACC4\">{{s.time}}</span>\n</div>\n</div>\n</template>\n</div>\n<div style=\"display:flex;flex-direction:column;gap:10px\">\n<button type=\"button\" onClick=\"{{onDeliver}}\" disabled=\"{{ordDone}}\" style=\"min-height:48px;border-radius:8px;border:0;background:#FF8A1F;color:#1A1206;font-size:16px;font-weight:600;font-family:inherit\">Giao thÃ´ng tin acc cho khÃ¡ch</button>\n<div style=\"display:flex;flex-wrap:wrap;gap:10px\">\n<button type=\"button\" style=\"flex:1 1 140px;min-height:44px;border-radius:8px;border:1px solid #2B3248;background:transparent;color:#EAEFFA;font-size:15px;font-weight:600;font-family:inherit\">Nháº¯n tin cho khÃ¡ch</button>\n<button type=\"button\" onClick=\"{{onRefund}}\" disabled=\"{{ordDone}}\" style=\"flex:1 1 140px;min-height:44px;border-radius:8px;border:1px solid #2B3248;background:transparent;color:#FF6B7A;font-size:15px;font-weight:600;font-family:inherit\">HoÃ n tiá»n</button>\n</div>\n</div>\n<label style=\"display:flex;flex-direction:column;gap:4px;font-size:14px;color:#A3ACC4\">Ghi chÃº ná»™i bá»™\n<textarea rows=\"3\" style=\"padding:10px 12px;background:#1F2538;border:1px solid #2B3248;border-radius:8px;color:#EAEFFA;font-size:16px;font-family:inherit;resize:vertical\"></textarea></label>\n</section>\n\n</div>\n</main>\n\n</div>\n",
