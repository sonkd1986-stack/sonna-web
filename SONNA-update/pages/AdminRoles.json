', contact: 'SÄT [Sá» ÄIá»†N THOáº I]', scope: 'char', locked: true, items: [\n['CI-1038', 'Character iOS', '05/10/2026 21:00', 900000, true] ] }\n];\nconst ALL = BASE.concat(st.extra).map((c) => ({\n...c,\nisLocked: st.locks[c.id] !== undefined ? st.locks[c.id] : !!c.locked,\nlist: c.items.map((it) => ({ id: it[0], cat: it[1], time: it[2], price: it[3], paid: st.paidMap[c.id + '|' + it[0]] !== undefined ? st.paidMap[c.id + '|' + it[0]] : it[4] }))\n}));\nconst sumOf = (c, paid) => c.list.filter((i) => i.paid === paid).reduce((a, i) => a + i.price, 0);\n\nconst rows = ALL.map((c) => ({\nname: c.name, login: c.login, sold: c.list.length,\npaid: fmt(sumOf(c, true)), unpaid: fmt(sumOf(c, false)),\nstatus: c.isLocked ? 'Bá»‹ khÃ³a' : 'Hoáº¡t Ä‘á»™ng', col: c.isLocked ? bad : ok,\nbg: c.id === st.sel ? '#1F2538' : 'transparent',\npick: () => this.setState({ sel: c.id, ftab: 'all', resetDone: false })\n}));\nconst totPaid = ALL.reduce((a, c) => a + sumOf(c, true), 0);\nconst totUnpaid = ALL.reduce((a, c) => a + sumOf(c, false), 0);\nconst totals = [\n{ k: 'Cá»™ng tÃ¡c viÃªn', v: String(ALL.length), col: '#EAEFFA' },\n{ k: 'Doanh thu CTV Ä‘Ã£ thanh toÃ¡n', v: fmt(totPaid), col: ok },\n{ k: 'Doanh thu CTV chÆ°a thanh toÃ¡n', v: fmt(totUnpaid), col: warn }\n];\n\nconst cur = ALL.find((c) => c.id === st.sel) || ALL[0];\nconst shown = cur.list.filter((i) => st.ftab === 'all' || (st.ftab === 'paid' && i.paid) || (st.ftab === 'unpaid' && !i.paid));\nconst sel = {\nname: cur.name, login: cur.login, contact: cur.contact, scope: scopeLabel[cur.scope],\nlockLabel: cur.isLocked ? 'Má»Ÿ khÃ³a CTV' : 'KhÃ³a CTV', lockCol: cur.isLocked ? ok : bad,\nstats: [\n{ k: 'Acc Ä‘Ã£ Ä‘Äƒng bÃ¡n Ä‘Æ°á»£c', v: cur.list.length + ' acc', col: '#EAEFFA' },\n{ k: 'Tá»•ng doanh thu', v: fmt(sumOf(cur, true) + sumOf(cur, false)), col: '#EAEFFA' },\n{ k: 'ÄÃ£ thanh toÃ¡n', v: fmt(sumOf(cur, true)), col: ok },\n{ k: 'ChÆ°a thanh toÃ¡n', v: fmt(sumOf(cur, false)), col: warn }\n],\nitems: shown.map((i) =