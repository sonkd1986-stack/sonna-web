l: ok },\n{ k: 'ChÆ°a thanh toÃ¡n', v: fmt(sumOf(pc, false)), col: warn }\n];\n\nreturn {\nnav, tabs, rows, totals, sel, ftabs, matrix, portalStats, portalName: pc.name,\nisList: st.tab === 'list', isMatrix: st.tab === 'matrix', isPortal: st.tab === 'portal',\nresetDone: st.resetDone,\nonLock: () => this.setState({ locks: { ...this.state.locks, [cur.id]: !cur.isLocked } }),\nonReset: () => this.setState({ resetDone: true }),\nfName: st.fName, fLogin: st.fLogin, fPass: st.fPass, fContact: st.fContact,\nonName: (e) => this.setState({ fName: e.target.value, formOk: '', formErr: '' }),\nonLogin: (e) => this.setState({ fLogin: e.target.value, formOk: '', formErr: '' }),\nonPass: (e) => this.setState({ fPass: e.target.value, formOk: '', formErr: '' }),\nonContact: (e) => this.setState({ fContact: e.target.value }),\nonScope: (e) => this.setState({ fScope: e.target.value }),\nscopeAll: st.fScope === 'all', scopeReroll: st.fScope === 'reroll', scopeChar: st.fScope === 'char',\nformErr: st.formErr !== '', formErrText: st.formErr,\nformOk: st.formOk !== '', formOkText: st.formOk,\nonAdd: () => {\nconst name = st.fName.trim(), login = st.fLogin.trim().toLowerCase();\nif (name === '' || login === '') return this.setState({ formErr: 'Nháº­p tÃªn hiá»ƒn thá»‹ vÃ  tÃªn Ä‘Äƒng nháº­p.', formOk: '' });\nif (!/^[a-z0-9_]{4,20}$/.test(login)) return this.setState({ formErr: 'TÃªn Ä‘Äƒng nháº­p 4-20 kÃ½ tá»±: chá»¯ thÆ°á»ng, sá»‘ hoáº·c dáº¥u gáº¡ch dÆ°á»›i.', formOk: '' });\nif (ALL.some((c) => c.login === login)) return this.setState({ formErr: 'TÃªn Ä‘Äƒng nháº­p nÃ y Ä‘Ã£ tá»“n táº¡i.', formOk: '' });\nif (st.fPass.length < 8) return this.setState({ formErr: 'Máº­t kháº©u táº¡m cáº§n Ã­t nháº¥t 8 kÃ½ tá»±.', formOk: '' });\nconst id = 'CTV-0' + (ALL.length + 1);\nthis.setState({\nextra: [...st.extra, { id, name, login, contact: st.fContact.trim() || '[LiÃªn há»‡]', scope: st.fScope, items: [] }],\nsel: id, ftab: 'all', fName: '', fLogin: '', fContact: '', formErr: '',\nformOk: 'Ä