{
 "tpl": "\n\n<div style=\"min-height:100%;background:#0F1320;color:#EAEFFA;font-family:'Barlow',system-ui,sans-serif;font-size:16px;line-height:1.5;display:flex;flex-wrap:wrap\">\n\n<aside style=\"flex:1 1 230px;max-width:100%;background:#171C2B;border-right:1px solid #2B3248;padding:20px 16px;display:flex;flex-direction:column;gap:20px;box-sizing:border-box\">\n<a href=\"Store.dc.html\" style=\"display:flex;align-items:center;gap:10px;color:#EAEFFA;padding:0 8px\">\n<img src=\"/sonna-mark.svg\" width=\"34\" height=\"34\" alt=\"SONNA\" style=\"display:block\">\n<span style=\"font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:24px;letter-spacing:0.05em\">SONNA <span style=\"color:#A3ACC4;font-size:14px;letter-spacing:0.1em\">ADMIN</span></span>\n</a>\n<nav aria-label=\"Menu quản trị\" style=\"display:flex;flex-direction:column;gap:4px\">\n<template data-tag=\"sc-for\" list=\"{{nav}}\" as=\"n\" hint-placeholder-count=\"10\">\n<a href=\"{{n.href}}\" style=\"display:flex;align-items:center;min-height:44px;padding:0 12px;border-radius:8px;font-weight:500;background:{{n.bg}};color:{{n.fg}}\">{{n.label}}</a>\n</template>\n</nav>\n<div style=\"margin-top:auto;padding:12px;background:#1F2538;border-radius:10px;font-size:14px;display:flex;flex-direction:column\">\n<span style=\"font-weight:600\">[Tên admin]</span>\n<span style=\"color:#A3ACC4\">Quản trị viên</span>\n</div>\n</aside>\n\n<main style=\"flex:999 1 560px;min-width:0;padding:28px 32px;display:flex;flex-direction:column;gap:20px;box-sizing:border-box\">\n<div style=\"display:flex;flex-direction:column\">\n<h1 style=\"margin:0;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:40px;line-height:1.1\">Phân quyền</h1>\n<span style=\"color:#A3ACC4;font-size:14px\">Thêm tài khoản cộng tác viên (CTV). CTV chỉ đăng acc và xem doanh thu của chính mình. Dữ liệu mẫu.</span>\n</div>\n\n<div role=\"tablist\" aria-label=\"Nhóm phân quyền\" style=\"display:flex;flex-wrap:wrap;gap:4px 20px;border-bottom:1px solid #2B3248\">\n<template data-tag=\"sc-for\" list=\"{{tabs}}\" as=\"t\" hint-placeholder-count=\"3\">\n<button type=\"button\" role=\"tab\" onClick=\"{{t.pick}}\" style=\"display:inline-flex;align-items:center;min-height:44px;padding:0 4px;border:0;border-bottom:3px solid {{t.line}};background:transparent;font-size:16px;font-weight:600;font-family:inherit;cursor:pointer;color:{{t.fg}}\">{{t.label}}</button>\n</template>\n</div>\n\n<!-- TAB CTV -->\n<template data-tag=\"sc-if\" value=\"{{isList}}\" hint-placeholder-val=\"{{true}}\">\n<section style=\"display:flex;flex-direction:column;gap:20px\">\n\n<div style=\"display:flex;flex-wrap:wrap;gap:12px\">\n<template data-tag=\"sc-for\" list=\"{{totals}}\" as=\"s\" hint-placeholder-count=\"3\">\n<div style=\"flex:1 1 200px;padding:16px 20px;background:#171C2B;border:1px solid #2B3248;border-radius:12px;display:flex;flex-direction:column\">\n<span style=\"font-size:14px;color:#A3ACC4\">{{s.k}}</span>\n<span style=\"font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:32px;line-height:1.2;color:{{s.col}}\">{{s.v}}</span>\n</div>\n</template>\n</div>\n\n<div style=\"display:flex;flex-wrap:wrap;gap:20px;align-items:flex-start\">\n<section aria-label=\"Danh sách cộng tác viên\" style=\"flex:1 1 440px;min-width:0;background:#171C2B;border:1px solid #2B3248;border-radius:12px;overflow:hidden\">\n<div style=\"padding:16px 20px;border-bottom:1px solid #2B3248;font-weight:600\">Cộng tác viên</div>\n<div style=\"overflow-x:auto;max-height:520px;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable\">\n<table style=\"width:100%;min-width:520px;border-collapse:collapse;font-size:15px\">\n<thead><tr style=\"text-align:left;color:#A3ACC4;font-size:13px\">\n<th style=\"padding:10px 12px;border-bottom:1px solid #2B3248;font-weight:500;position:sticky;top:0;z-index:1;background:#171C2B\">CTV</th>\n<th style=\"padding:10px 12px;border-bottom:1px solid #2B3248;font-weight:500;position:sticky;top:0;z-index:1;background:#171C2B\">Đã bán</th>\n<th style=\"padding:10px 12px;border-bottom:1px solid #2B3248;font-weight:500;position:sticky;top:0;z-index:1;background:#171C2B\">Đã thanh toán</th>\n<th style=\"padding:10px 12px;border-bottom:1px solid #2B3248;font-weight:500;position:sticky;top:0;z-index:1;background:#171C2B\">Chưa thanh toán</th>\n<th style=\"padding:10px 12px;border-bottom:1px solid #2B3248;font-weight:500;position:sticky;top:0;z-index:1;background:#171C2B\">Trạng thái</th>\n<th style=\"padding:10px 12px;border-bottom:1px solid #2B3248;font-weight:500;position:sticky;top:0;z-index:1;background:#171C2B\"></th>\n</tr></thead>\n<tbody>\n<template data-tag=\"sc-for\" list=\"{{rows}}\" as=\"c\" hint-placeholder-count=\"3\">\n<tr style=\"background:{{c.bg}}\">\n<td style=\"padding:10px 12px;border-bottom:1px solid #2B3248\"><div style=\"display:flex;flex-direction:column\"><span style=\"font-weight:600\">{{c.name}}</span><span style=\"font-size:13px;color:#A3ACC4\">{{c.login}}</span></div></td>\n<td style=\"padding:10px 12px;border-bottom:1px solid #2B3248\">{{c.sold}} acc</td>\n<td style=\"padding:10px 12px;border-bottom:1px solid #2B3248;color:#43D9A0;font-weight:600;white-space:nowrap\">{{c.paid}}</td>\n<td style=\"padding:10px 12px;border-bottom:1px solid #2B3248;color:#FFC24B;font-weight:600;white-space:nowrap\">{{c.unpaid}}</td>\n<td style=\"padding:10px 12px;border-bottom:1px solid #2B3248\"><span style=\"padding:2px 12px;border-radius:999px;background:#0F1320;font-size:13px;font-weight:600;white-space:nowrap;color:{{c.col}}\">{{c.status}}</span></td>\n<td style=\"padding:10px 12px;border-bottom:1px solid #2B3248\"><button type=\"button\" onClick=\"{{c.pick}}\" style=\"min-height:36px;padding:0 12px;border-radius:8px;border:1px solid #2B3248;background:transparent;color:#EAEFFA;font-size:14px;font-family:inherit;cursor:pointer\">Xem</button></td>\n</tr>\n</template>\n</tbody>\n</table>\n</div>\n</section>\n\n<section aria-labelledby=\"add-title\" style=\"flex:1 1 320px;min-width:0;background:#171C2B;border:1px solid #2B3248;border-radius:12px;padding:20px;display:flex;flex-direction:column;gap:12px\">\n<h2 id=\"add-title\" style=\"margin:0;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:26px\">Thêm cộng tác viên</h2>\n<label style=\"display:flex;flex-direction:column;gap:4px;font-size:14px;color:#A3ACC4\">Tên hiển thị\n<input type=\"text\" value=\"{{fName}}\" onChange=\"{{onName}}\" style=\"min-height:44px;padding:0 12px;background:#0F1320;border:1px solid #2B3248;border-radius:8px;color:#EAEFFA;font-size:16px;font-family:inherit\"></label>\n<label style=\"display:flex;flex-direction:column;gap:4px;font-size:14px;color:#A3ACC4\">Tên đăng nhập\n<input type=\"text\" value=\"{{fLogin}}\" onChange=\"{{onLogin}}\" placeholder=\"ví dụ: ctv_nam\" autocomplete=\"off\" style=\"min-height:44px;padding:0 12px;background:#0F1320;border:1px solid #2B3248;border-radius:8px;color:#EAEFFA;font-size:16px;font-family:inherit\"></label>\n<label style=\"display:flex;flex-direction:column;gap:4px;font-size:14px;color:#A3ACC4\">Mật khẩu tạm\n<input type=\"text\" value=\"{{fPass}}\" onChange=\"{{onPass}}\" autocomplete=\"off\" style=\"min-height:44px;padding:0 12px;background:#0F1320;border:1px solid #2B3248;border-radius:8px;color:#EAEFFA;font-size:16px;font-family:inherit\"></label>\n<label style=\"display:flex;flex-direction:column;gap:4px;font-size:14px;color:#A3ACC4\">Liên hệ (Zalo / SĐT)\n<input type=\"text\" value=\"{{fContact}}\" onChange=\"{{onContact}}\" style=\"min-height:44px;padding:0 12px;background:#0F1320;border:1px solid #2B3248;border-radius:8px;color:#EAEFFA;font-size:16px;font-family:inherit\"></label>\n<label style=\"display:flex;flex-direction:column;gap:4px;font-size:14px;color:#A3ACC4\">Được đăng vào mục\n<select onChange=\"{{onScope}}\" style=\"min-height:44px;padding:0 12px;background:#0F1320;border:1px solid #2B3248;border-radius:8px;color:#EAEFFA;font-size:16px;font-family:inherit\"><option value=\"all\" selected=\"{{scopeAll}}\">Tất cả mục (trừ Khuyến mãi)</option><option value=\"reroll\" selected=\"{{scopeReroll}}\">Chỉ Acc Reroll</option><option value=\"char\" selected=\"{{scopeChar}}\">Chỉ Character + Chrono</option></select></label>\n<div style=\"padding:10px 12px;background:#1F2538;border-radius:10px;font-size:13px;color:#A3ACC4\">Quyền của CTV: đăng acc (đơn lẻ hoặc hàng loạt TK|MK) và xem doanh thu của chính mình. Không xem được acc, doanh thu hay khách của người khác.</div>\n<template data-tag=\"sc-if\" value=\"{{formErr}}\" hint-placeholder-val=\"{{false}}\"><div role=\"alert\" style=\"color:#FF9AA5;font-size:14px\">{{formErrText}}</div></template>\n<template data-tag=\"sc-if\" value=\"{{formOk}}\" hint-placeholder-val=\"{{false}}\"><div role=\"status\" style=\"color:#43D9A0;font-size:14px;font-weight:600\">{{formOkText}}</div></template>\n<button type=\"button\" onClick=\"{{onAdd}}\" style=\"min-height:48px;border-radius:8px;border:0;background:#FF8A1F;color:#1A1206;font-size:16px;font-weight:600;font-family:inherit;cursor:pointer\">Tạo tài khoản CTV</button>\n</section>\n</div>\n\n<section aria-labelledby=\"det-title\" style=\"background:#171C2B;border:1px solid #2B3248;border-radius:12px;padding:20px;display:flex;flex-direction:column;gap:16px\">\n<div style=\"display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-start;gap:12px\">\n<div style=\"display:flex;flex-direction:column\">\n<h2 id=\"det-title\" style=\"margin:0;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:28px;line-height:1.15\">{{sel.name}}</h2>\n<span style=\"font-size:14px;color:#A3ACC4\">{{sel.login}} · {{sel.contact}} · {{sel.scope}}</span>\n</div>\n<div style=\"display:flex;flex-wrap:wrap;gap:10px\">\n<button type=\"button\" onClick=\"{{onLock}}\" style=\"min-height:44px;padding:0 16px;border-radius:8px;border:1px solid #2B3248;background:transparent;font-size:15px;font-weight:600;font-family:inherit;cursor:pointer;color:{{sel.lockCol}}\">{{sel.lockLabel}}</button>\n<button type=\"button\" onClick=\"{{onReset}}\" style=\"min-height:44px;padding:0 16px;border-radius:8px;border:1px solid #2B3248;background:transparent;color:#EAEFFA;font-size:15px;font-weight:600;font-family:inherit;cursor:pointer\">Đặt lại mật khẩu</button>\n</div>\n</div>\n<template data-tag=\"sc-if\" value=\"{{resetDone}}\" hint-placeholder-val=\"{{false}}\"><div role=\"status\" style=\"color:#43D9A0;font-size:14px;font-weight:600\">Đã tạo mật khẩu tạm mới (mô phỏng). CTV phải đổi khi đăng nhập lại.</div></template>\n\n<div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px\">\n<template data-tag=\"sc-for\" list=\"{{sel.stats}}\" as=\"s\" hint-placeholder-count=\"4\">\n<div style=\"padding:12px 14px;background:#1F2538;border-radius:10px;display:flex;flex-direction:column\">\n<span style=\"font-size:13px;color:#A3ACC4\">{{s.k}}</span>\n<span style=\"font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:26px;line-height:1.2;color:{{s.col}}\">{{s.v}}</span>\n</div>\n</template>\n</div>\n\n<div role=\"tablist\" aria-label=\"Lọc theo doanh thu\" style=\"display:flex;flex-wrap:wrap;gap:4px 20px;border-bottom:1px solid #2B3248\">\n<template data-tag=\"sc-for\" list=\"{{ftabs}}\" as=\"t\" hint-placeholder-count=\"3\">\n<button type=\"button\" role=\"tab\" onClick=\"{{t.pick}}\" style=\"display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 4px;border:0;border-bottom:3px solid {{t.line}};background:transparent;font-size:16px;font-weight:600;font-family:inherit;cursor:pointer;color:{{t.fg}}\">{{t.label}} <span style=\"padding:0 8px;border-radius:999px;background:#1F2538;font-size:13px;color:#A3ACC4\">{{t.count}}</span></button>\n</template>\n</div>\n\n<div style=\"overflow-x:auto;max-height:520px;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable\">\n<table style=\"width:100%;min-width:620px;border-collapse:collapse;font-size:15px\">\n<thead><tr style=\"text-align:left;color:#A3ACC4;font-size:13px\">\n<th style=\"padding:10px 12px;border-bottom:1px solid #2B3248;font-weight:500;position:sticky;top:0;z-index:1;background:#171C2B\">Acc</th>\n<th style=\"padding:10px 12px;border-bottom:1px solid #2B3248;font-weight:500;position:sticky;top:0;z-index:1;background:#171C2B\">Bán lúc</th>\n<th style=\"padding:10px 12px;border-bottom:1px solid #2B3248;font-weight:500;position:sticky;top:0;z-index:1;background:#171C2B\">Giá bán</th>\n<th style=\"padding:10px 12px;border-bottom:1px solid #2B3248;font-weight:500;position:sticky;top:0;z-index:1;background:#171C2B\">Thanh toán cho CTV</th>\n<th style=\"padding:10px 12px;border-bottom:1px solid #2B3248;font-weight:500;position:sticky;top:0;z-index:1;background:#171C2B\">Thao tác</th>\n</tr></thead>\n<tbody>\n<template data-tag=\"sc-for\" list=\"{{sel.items}}\" as=\"i\" hint-placeholder-count=\"5\">\n<tr>\n<td style=\"padding:10px 12px;border-bottom:1px solid #2B3248\"><span style=\"font-weight:600\">{{i.id}}</span> <span style=\"font-size:13px;color:#A3ACC4\">· {{i.cat}}</span></td>\n<td style=\"padding:10px 12px;border-bottom:1px solid #2B3248;white-space:nowrap\">{{i.time}}</td>\n<td style=\"padding:10px 12px;border-bottom:1px solid #2B3248;white-space:nowrap\">{{i.price}}</td>\n<td style=\"padding:10px 12px;border-bottom:1px solid #2B3248\"><span style=\"padding:2px 12px;border-radius:999px;background:#0F1320;font-size:13px;font-weight:600;white-space:nowrap;color:{{i.col}}\">{{i.status}}</span></td>\n<td style=\"padding:10px 12px;border-bottom:1px solid #2B3248\"><button type=\"button\" onClick=\"{{i.toggle}}\" style=\"min-height:36px;padding:0 12px;border-radius:8px;border:1px solid #2B3248;background:transparent;color:#EAEFFA;font-size:14px;font-family:inherit;cursor:pointer\">{{i.action}}</button></td>\n</tr>\n</template>\n</tbody>\n</table>\n</div>\n<template data-tag=\"sc-if\" value=\"{{sel.noItems}}\" hint-placeholder-val=\"{{false}}\"><div role=\"status\" style=\"color:#A3ACC4;font-size:15px\">Không có acc nào trong mục này.</div></template>\n<span style=\"font-size:13px;color:#A3ACC4\">“Đã thanh toán” = shop đã trả tiền cho CTV. “Chưa thanh toán” = acc của CTV đã bán nhưng shop chưa trả. Số tiền theo giá bán; tỷ lệ hoa hồng [PHẦN TRĂM HOA HỒNG] sẽ chốt sau.</span>\n</section>\n</section>\n</template>\n\n<!-- TAB MA TRẬN QUYỀN -->\n<template data-tag=\"sc-if\" value=\"{{isMatrix}}\" hint-placeholder-val=\"{{false}}\">\n<section aria-label=\"Bảng quyền\" style=\"background:#171C2B;border:1px solid #2B3248;border-radius:12px;overflow:hidden\">\n<div style=\"overflow-x:auto;max-height:520px;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable\">\n<table style=\"width:100%;min-width:560px;border-collapse:collapse;font-size:15px\">\n<thead><tr style=\"text-align:left;color:#A3ACC4;font-size:13px\">\n<th style=\"padding:12px 16px;border-bottom:1px solid #2B3248;font-weight:500;position:sticky;top:0;z-index:1;background:#171C2B\">Chức năng</th>\n<th style=\"padding:12px 16px;border-bottom:1px solid #2B3248;font-weight:500;position:sticky;top:0;z-index:1;background:#171C2B\">Quản trị viên</th>\n<th style=\"padding:12px 16px;border-bottom:1px solid #2B3248;font-weight:500;position:sticky;top:0;z-index:1;background:#171C2B\">Cộng tác viên</th>\n</tr></thead>\n<tbody>\n<template data-tag=\"sc-for\" list=\"{{matrix}}\" as=\"m\" hint-placeholder-count=\"10\">\n<tr>\n<td style=\"padding:12px 16px;border-bottom:1px solid #2B3248\">{{m.label}}</td>\n<td style=\"padding:12px 16px;border-bottom:1px solid #2B3248\"><span style=\"font-weight:600;color:#43D9A0\">Có</span></td>\n<td style=\"padding:12px 16px;border-bottom:1px solid #2B3248\"><span style=\"font-weight:600;color:{{m.col}}\">{{m.ctv}}</span></td>\n</tr>\n</template>\n</tbody>\n</table>\n</div>\n<div style=\"padding:12px 16px;font-size:14px;color:#A3ACC4\">Quyền của CTV cố định theo yêu cầu: chỉ đăng acc và xem doanh thu của chính mình. Muốn mở thêm quyền, thêm vai trò mới sau.</div>\n</section>\n</template>\n\n<!-- TAB CỔNG CTV -->\n<template data-tag=\"sc-if\" value=\"{{isPortal}}\" hint-placeholder-val=\"{{false}}\">\n<section aria-label=\"Xem thử cổng cộng tác viên\" style=\"display:flex;flex-direction:column;gap:12px\">\n<div style=\"padding:12px 16px;background:#1F2538;border-radius:10px;font-size:14px;color:#A3ACC4\">Đây là những gì CTV “{{portalName}}” thấy sau khi đăng nhập. CTV không có menu Đơn hàng, Thanh toán, Người dùng…</div>\n<div style=\"background:#0F1320;border:1px solid #2B3248;border-radius:12px;overflow:hidden\">\n<div style=\"padding:14px 20px;background:#171C2B;border-bottom:1px solid #2B3248;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px\">\n<span style=\"font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:22px;letter-spacing:0.05em\">SONNA · CỘNG TÁC VIÊN</span>\n<span style=\"font-size:14px;color:#A3ACC4\">{{portalName}}</span>\n</div>\n<div style=\"padding:20px;display:flex;flex-wrap:wrap;gap:20px;align-items:flex-start\">\n<div style=\"flex:1 1 360px;min-width:0;display:flex;flex-direction:column;gap:12px\">\n<span style=\"font-weight:600\">Đăng acc</span>\n<label style=\"display:flex;flex-direction:column;gap:4px;font-size:14px;color:#A3ACC4\">Mục đăng\n<select style=\"min-height:44px;padding:0 12px;background:#171C2B;border:1px solid #2B3248;border-radius:8px;color:#EAEFFA;font-size:16px;font-family:inherit\"><option>Acc Reroll iOS</option><option>Acc Reroll Android</option><option>Acc Character + Chrono iOS</option><option>Acc Character + Chrono Android</option><option>Team Meta</option></select></label>\n<label style=\"display:flex;flex-direction:column;gap:4px;font-size:14px;color:#A3ACC4\">Danh sách TK|MK (mỗi dòng một acc)\n<textarea rows=\"5\" placeholder=\"taikhoan1|matkhau1&#10;taikhoan2|matkhau2\" style=\"padding:10px 12px;background:#171C2B;border:1px solid #2B3248;border-radius:8px;color:#EAEFFA;font-size:16px;font-family:ui-monospace,Menlo,Consolas,monospace;resize:vertical\"></textarea></label>\n<label style=\"display:flex;flex-direction:column;gap:4px;font-size:14px;color:#A3ACC4\">Giá bán đề xuất (₫)\n<input type=\"text\" placeholder=\"0\" style=\"min-height:44px;padding:0 12px;background:#171C2B;border:1px solid #2B3248;border-radius:8px;color:#EAEFFA;font-size:16px;font-family:inherit\"></label>\n<button type=\"button\" style=\"min-height:48px;border-radius:8px;border:0;background:#FF8A1F;color:#1A1206;font-size:16px;font-weight:600;font-family:inherit\">Gửi acc lên kho</button>\n<span style=\"font-size:13px;color:#A3ACC4\">Acc CTV đăng vào kho chờ admin kiểm tra rồi mới lên bán. CTV không sửa hay xóa được acc đã bán.</span>\n</div>\n<div style=\"flex:1 1 320px;min-width:0;display:flex;flex-direction:column;gap:12px\">\n<span style=\"font-weight:600\">Doanh thu của tôi</span>\n<div style=\"display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px\">\n<template data-tag=\"sc-for\" list=\"{{portalStats}}\" as=\"s\" hint-placeholder-count=\"4\">\n<div style=\"padding:12px 14px;background:#171C2B;border:1px solid #2B3248;border-radius:10px;display:flex;flex-direction:column\">\n<span style=\"font-size:13px;color:#A3ACC4\">{{s.k}}</span>\n<span style=\"font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:26px;line-height:1.2;color:{{s.col}}\">{{s.v}}</span>\n</div>\n</template>\n</div>\n<span style=\"font-size:13px;color:#A3ACC4\">CTV chỉ thấy số tiền và trạng thái thanh toán, không thấy thông tin người mua.</span>\n</div>\n</div>\n</div>\n</section>\n</template>\n\n</main>\n</div>\n",
 "helmet": "\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&amp;family=Barlow:wght@400;500;600&amp;display=swap\">\n<style>\nbody{margin:0;background:#0F1320}\na{color:#52C7FF;text-decoration:none}a:hover{color:#8EDDFF}\na:focus-visible,button:focus-visible,select:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid #52C7FF;outline-offset:2px}\n</style>\n",
 "script": "\nclass Component extends DCLogic {\nstate = {\ntab: 'list', sel: 'CTV-01', ftab: 'all', resetDone: false,\nfName: '', fLogin: '', fPass: 'Sonna@2026', fContact: '', fScope: 'all', formErr: '', formOk: '',\nextra: [],\nlocks: {},\npaidMap: {}\n};\nrenderVals() {\nconst on = '#FF8A1F', off = '#A3ACC4', ok = '#43D9A0', bad = '#FF6B7A', warn = '#FFC24B';\nconst st = this.state;\nconst fmt = (n) => String(n).replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.') + '₫';\nconst nav = [\n{ label: 'Tổng quan', href: 'AdminDashboard.dc.html' },\n{ label: 'Quản lý acc', href: 'AdminAccounts.dc.html' },\n{ label: 'Đơn hàng', href: 'AdminOrders.dc.html' },\n{ label: 'Thanh toán', href: 'AdminPayments.dc.html' },\n{ label: 'Người dùng', href: 'AdminUsers.dc.html' },\n{ label: 'Khuyến mãi', href: 'AdminPromos.dc.html' },\n{ label: 'Nội dung website', href: 'AdminContent.dc.html' },\n{ label: 'Báo cáo', href: '#bao-cao' },\n{ label: 'Phân quyền', href: 'AdminRoles.dc.html', active: true },\n{ label: 'Nhật ký hoạt động', href: '#nhat-ky' }\n].map((n) => ({ ...n, bg: n.active ? '#1F2538' : 'transparent', fg: n.active ? on : off }));\n\nconst scopeLabel = { all: 'Tất cả mục (trừ Khuyến mãi)', reroll: 'Chỉ Acc Reroll', char: 'Chỉ Character + Chrono' };\nconst BASE = [\n{ id: 'CTV-01', name: 'Nguyễn Hoàng Nam', login: 'ctv_nam', contact: 'Zalo [SỐ ZALO]', scope: 'all', items: [\n['RI-0221', 'Reroll iOS', '10/10/2026 20:15', 500000, true],\n['RA-0342', 'Reroll Android', '09/10/2026 11:02', 330000, true],\n['CA-1042', 'Character Android', '16/10/2026 09:41', 1250000, false],\n['RA-0350', 'Reroll Android', '16/10/2026 08:30', 400000, false] ] },\n{ id: 'CTV-02', name: 'Trần Minh Khoa', login: 'ctv_khoa', contact: 'Zalo [SỐ ZALO]', scope: 'reroll', items: [\n['RI-0230', 'Reroll iOS', '12/10/2026 14:20', 450000, true],\n['RI-0233', 'Reroll iOS', '15/10/2026 19:05', 450000, false] ] },\n{ id: 'CTV-03', name: 'Lê Thu Hà', login: 'ctv_ha', contact: 'SĐT [SỐ ĐIỆN THOẠI]', scope: 'char', locked: true, items: [\n['CI-1038', 'Character iOS', '05/10/2026 21:00', 900000, true] ] }\n];\nconst ALL = BASE.concat(st.extra).map((c) => ({\n...c,\nisLocked: st.locks[c.id] !== undefined ? st.locks[c.id] : !!c.locked,\nlist: c.items.map((it) => ({ id: it[0], cat: it[1], time: it[2], price: it[3], paid: st.paidMap[c.id + '|' + it[0]] !== undefined ? st.paidMap[c.id + '|' + it[0]] : it[4] }))\n}));\nconst sumOf = (c, paid) => c.list.filter((i) => i.paid === paid).reduce((a, i) => a + i.price, 0);\n\nconst rows = ALL.map((c) => ({\nname: c.name, login: c.login, sold: c.list.length,\npaid: fmt(sumOf(c, true)), unpaid: fmt(sumOf(c, false)),\nstatus: c.isLocked ? 'Bị khóa' : 'Hoạt động', col: c.isLocked ? bad : ok,\nbg: c.id === st.sel ? '#1F2538' : 'transparent',\npick: () => this.setState({ sel: c.id, ftab: 'all', resetDone: false })\n}));\nconst totPaid = ALL.reduce((a, c) => a + sumOf(c, true), 0);\nconst totUnpaid = ALL.reduce((a, c) => a + sumOf(c, false), 0);\nconst totals = [\n{ k: 'Cộng tác viên', v: String(ALL.length), col: '#EAEFFA' },\n{ k: 'Doanh thu CTV đã thanh toán', v: fmt(totPaid), col: ok },\n{ k: 'Doanh thu CTV chưa thanh toán', v: fmt(totUnpaid), col: warn }\n];\n\nconst cur = ALL.find((c) => c.id === st.sel) || ALL[0];\nconst shown = cur.list.filter((i) => st.ftab === 'all' || (st.ftab === 'paid' && i.paid) || (st.ftab === 'unpaid' && !i.paid));\nconst sel = {\nname: cur.name, login: cur.login, contact: cur.contact, scope: scopeLabel[cur.scope],\nlockLabel: cur.isLocked ? 'Mở khóa CTV' : 'Khóa CTV', lockCol: cur.isLocked ? ok : bad,\nstats: [\n{ k: 'Acc đã đăng bán được', v: cur.list.length + ' acc', col: '#EAEFFA' },\n{ k: 'Tổng doanh thu', v: fmt(sumOf(cur, true) + sumOf(cur, false)), col: '#EAEFFA' },\n{ k: 'Đã thanh toán', v: fmt(sumOf(cur, true)), col: ok },\n{ k: 'Chưa thanh toán', v: fmt(sumOf(cur, false)), col: warn }\n],\nitems: shown.map((i) => ({\nid: i.id, cat: i.cat, time: i.time, price: fmt(i.price),\nstatus: i.paid ? 'Đã thanh toán' : 'Chưa thanh toán', col: i.paid ? ok : warn,\naction: i.paid ? 'Hoàn tác' : 'Đánh dấu đã trả',\ntoggle: () => this.setState({ paidMap: { ...this.state.paidMap, [cur.id + '|' + i.id]: !i.paid } })\n})),\nnoItems: shown.length === 0\n};\nconst ftabs = [\n{ id: 'all', label: 'Tất cả', count: cur.list.length },\n{ id: 'paid', label: 'Đã thanh toán', count: cur.list.filter((i) => i.paid).length },\n{ id: 'unpaid', label: 'Chưa thanh toán', count: cur.list.filter((i) => !i.paid).length }\n].map((t) => ({ ...t, pick: () => this.setState({ ftab: t.id }), line: t.id === st.ftab ? on : 'transparent', fg: t.id === st.ftab ? '#EAEFFA' : off }));\n\nconst tabs = [\n{ id: 'list', label: 'Cộng tác viên' },\n{ id: 'matrix', label: 'Bảng quyền' },\n{ id: 'portal', label: 'Xem thử cổng CTV' }\n].map((t) => ({ ...t, pick: () => this.setState({ tab: t.id }), line: t.id === st.tab ? on : 'transparent', fg: t.id === st.tab ? '#EAEFFA' : off }));\n\nconst matrix = [\n['Đăng acc (đơn lẻ và hàng loạt TK|MK)', 'Có'],\n['Xem doanh thu của chính mình (đã và chưa thanh toán)', 'Có'],\n['Xem acc và doanh thu của CTV khác', 'Không'],\n['Sửa giá, xóa acc đã bán', 'Không'],\n['Xem Tổng quan, Đơn hàng, thông tin người mua', 'Không'],\n['Thanh toán, nạp ví, thẻ cào', 'Không'],\n['Người dùng, Khuyến mãi, mã giảm giá', 'Không'],\n['Nội dung website', 'Không'],\n['Thêm hoặc khóa tài khoản CTV', 'Không'],\n['Đăng vào mục Acc Khuyến Mãi (kho quà tặng)', 'Không']\n].map((m) => ({ label: m[0], ctv: m[1], col: m[1] === 'Có' ? ok : bad }));\n\nconst pc = ALL[0];\nconst portalStats = [\n{ k: 'Tổng doanh thu', v: fmt(sumOf(pc, true) + sumOf(pc, false)), col: '#EAEFFA' },\n{ k: 'Acc đã bán', v: pc.list.length + ' acc', col: '#EAEFFA' },\n{ k: 'Đã thanh toán', v: fmt(sumOf(pc, true)), col: ok },\n{ k: 'Chưa thanh toán', v: fmt(sumOf(pc, false)), col: warn }\n];\n\nreturn {\nnav, tabs, rows, totals, sel, ftabs, matrix, portalStats, portalName: pc.name,\nisList: st.tab === 'list', isMatrix: st.tab === 'matrix', isPortal: st.tab === 'portal',\nresetDone: st.resetDone,\nonLock: () => this.setState({ locks: { ...this.state.locks, [cur.id]: !cur.isLocked } }),\nonReset: () => this.setState({ resetDone: true }),\nfName: st.fName, fLogin: st.fLogin, fPass: st.fPass, fContact: st.fContact,\nonName: (e) => this.setState({ fName: e.target.value, formOk: '', formErr: '' }),\nonLogin: (e) => this.setState({ fLogin: e.target.value, formOk: '', formErr: '' }),\nonPass: (e) => this.setState({ fPass: e.target.value, formOk: '', formErr: '' }),\nonContact: (e) => this.setState({ fContact: e.target.value }),\nonScope: (e) => this.setState({ fScope: e.target.value }),\nscopeAll: st.fScope === 'all', scopeReroll: st.fScope === 'reroll', scopeChar: st.fScope === 'char',\nformErr: st.formErr !== '', formErrText: st.formErr,\nformOk: st.formOk !== '', formOkText: st.formOk,\nonAdd: () => {\nconst name = st.fName.trim(), login = st.fLogin.trim().toLowerCase();\nif (name === '' || login === '') return this.setState({ formErr: 'Nhập tên hiển thị và tên đăng nhập.', formOk: '' });\nif (!/^[a-z0-9_]{4,20}$/.test(login)) return this.setState({ formErr: 'Tên đăng nhập 4-20 ký tự: chữ thường, số hoặc dấu gạch dưới.', formOk: '' });\nif (ALL.some((c) => c.login === login)) return this.setState({ formErr: 'Tên đăng nhập này đã tồn tại.', formOk: '' });\nif (st.fPass.length < 8) return this.setState({ formErr: 'Mật khẩu tạm cần ít nhất 8 ký tự.', formOk: '' });\nconst id = 'CTV-0' + (ALL.length + 1);\nthis.setState({\nextra: [...st.extra, { id, name, login, contact: st.fContact.trim() || '[Liên hệ]', scope: st.fScope, items: [] }],\nsel: id, ftab: 'all', fName: '', fLogin: '', fContact: '', formErr: '',\nformOk: 'Đã tạo CTV ' + name + '. Gửi tên đăng nhập và mật khẩu tạm cho họ; họ đổi mật khẩu ở lần đăng nhập đầu.'\n});\n}\n};\n}\n}\n",
 "props": {},
 "title": "Admin - Phân quyền"
}
